# Kopiere diese Datei zu ".env" und trage deine eigenen Werte ein.
# Die .env wird NICHT committet (steht in .gitignore).

# --- SpielerPlus ---
SP_EMAIL=deine-email@example.com
SP_PASSWORD=deinPasswort
# Team-ID: mit "py show_training.py" werden deine Teams samt IDs aufgelistet.
SP_TEAM_ID=

# --- Anytype (lokale API) ---
# In der Anytype-Desktop-App: Einstellungen -> API Keys -> neuen Key erstellen.
Api_key=dein_anytype_api_key
# Space-ID deines Anytype-Space.
ANYTYPE_SPACE_ID=deine_space_id
